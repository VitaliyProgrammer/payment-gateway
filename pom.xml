<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.payflow</groupId>
    <artifactId>payment-gateway-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>payment-gateway</name>
    <description>
        Payment gateway with idempotent APIs, a guarded payment state machine
        and reliable webhook delivery.
    </description>

    <modules>
        <module>gateway</module>
        <module>mock-acquirer</module>
    </modules>

    <properties>
        <!--
            Java 21 rather than the newest release: it is the LTS that Spring Boot 3.5
            officially supports and the one most employers actually run in production.
            Virtual threads are final here, so nothing in this project needs preview flags.

            One consequence is deliberate: on 21 a virtual thread blocking inside a
            `synchronized` block pins its carrier thread (fixed only in JDK 24 by JEP 491).
            This project therefore uses ReentrantLock instead of synchronized wherever a
            virtual thread can block. See README, section "Concurrency notes".
        -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

</project>
