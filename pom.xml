<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.payflow</groupId>
    <artifactId>payment-gateway-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>payment-gateway</name>
    <description>
        Payment gateway with idempotent APIs, a guarded payment state machine
        and reliable webhook delivery.
    </description>

    <modules>
        <module>gateway</module>
        <module>mock-acquirer</module>
    </modules>

    <profiles>
        <!--
            benchmark - це лише навантажувальний інструмент розробника (стадія 7),
            а не частина продукту. Тримаємо його за профілем, щоб reactor у
            docker-складанні образів лишався з двох модулів (Dockerfile-и копіюють
            саме gateway/pom.xml і mock-acquirer/pom.xml). CI вмикає профіль явно:
            ./mvnw -B -Pbenchmark verify. Запуск самого бенчмарку - через
            ops/benchmark/run-benchmark.sh.
        -->
        <profile>
            <id>benchmark</id>
            <modules>
                <module>benchmark</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <!--
            Java 21, а не найновіша версія: це LTS-реліз, який офіційно підтримує
            Spring Boot 3.5, і саме та версія, яку реально використовує більшість
            роботодавців у продакшені. Віртуальні потоки тут фінальні (не preview),
            тож жодні прапорці для preview-фіч не потрібні.

            Один наслідок цього вибору свідомий: на Java 21 віртуальний потік, що
            блокується всередині блоку `synchronized`, "прибивається" до свого
            носійного потоку (виправлено лише в JDK 24, JEP 491). Тому в проєкті
            всюди, де віртуальний потік може заблокуватись, використовується
            ReentrantLock замість synchronized. Див. README, розділ "Concurrency notes".
        -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

</project>
