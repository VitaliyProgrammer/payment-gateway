# Copy to .env to override the host ports docker-compose publishes.
# Only the host side changes - ports inside the compose network are fixed.
# Defaults are chosen to avoid the usual clashes (9090, 5433, ...).

GATEWAY_PORT=8080
POSTGRES_PORT=5432
ACQUIRER_PORT=8090
PROMETHEUS_PORT=9091   # monitoring profile
GRAFANA_PORT=3000      # monitoring profile
